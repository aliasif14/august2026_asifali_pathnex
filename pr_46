Jenkins Pipeline — Trigger on Git Tag
pipeline {
    agent any

    environment {
        INSTITUTE_NAME = "Pathnex"
        TEAM           = "DevOps"
        ENV            = "prod"
    }

    triggers {
        pollSCM('H/15 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            when {
                buildingTag()
            }

            steps {
                sh '''
                    echo "Building $INSTITUTE_NAME app"
                    echo "Team: $TEAM"
                    echo "Environment: $ENV"
                '''
            }
        }
    }
}


