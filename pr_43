Ansible- Deploy app using git
---
- name: Deploy app from Git for Pathnex
  hosts: all
  become: yes

  tasks:
    - name: Install Git
      yum:
        name: git
        state: present

    - name: Clone application repository
      git:
        repo: "https://github.com/pathnex/app.git"
        dest: "/opt/pathnex-app"



Terraform - RDS skeleton
resource "aws_db_instance" "PathnexRDS" {
  identifier = "pathnex-rds"

  allocated_storage = 20

  engine         = "mysql"
  engine_version = "8.0"

  instance_class = "db.t3.micro"

  db_name  = "pathnexdb"
  username = "admin"
  password = var.db_password

  skip_final_snapshot = true
}



Kubernetes- deployment rolling update 
apiVersion: apps/v1
kind: Deployment

metadata:
  name: pathnex-rollout

spec:
  replicas: 3

  strategy:
    type: RollingUpdate

    rollingUpdate:
      maxSurge: 2
      maxUnavailable: 1

  selector:
    matchLabels:
      app: rollout

  template:
    metadata:
      labels:
        app: rollout

    spec:
      containers:
        - name: app
          image: nginx



