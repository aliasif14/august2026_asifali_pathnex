Ansible
- name: Install tool based on OS
  hosts: all
  become: yes
  tasks:
    - name: Install htop
      ansible.builtin.yum:
        name: htop
        state: present
      when: ansible_facts['os_family'] == "RedHat"

Terraform
# 1. Base VPC Resource
resource "aws_vpc" "PathnexVPC" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true

  tags = {
    Name = "Pathnex-VPC"
  }
}

# 2. Internet Gateway Resource
resource "aws_internet_gateway" "PathnexIGW" {
  vpc_id = aws_vpc.PathnexVPC.id

  tags = {
    Name = "Pathnex-IGW"
  }
}

# 3. Subnet Resource
resource "aws_subnet" "PathnexSubnet" {
  vpc_id                  = aws_vpc.PathnexVPC.id
  cidr_block              = "10.0.1.0/24"
  map_public_ip_on_launch = true

  tags = {
    Name = "Pathnex-Subnet"
  }
}

# 4. Route Table Configuration
resource "aws_route_table" "PathnexRT" {
  vpc_id = aws_vpc.PathnexVPC.id

  route {
    cidr_block = "0.0.0.0/0"
[O    gateway_id = aws_internet_gateway.PathnexIGW.id
  }

  tags = {
    Name = "Pathnex-RouteTable"
  }
}

# 5. Route Table Association Block
resource "aws_route_table_association" "PathnexRTA" {
  subnet_id      = aws_subnet.PathnexSubnet.id
  route_table_id = aws_route_table.PathnexRT.id
}


