Jenkins pipeline
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Pathnex"
    }
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com'
            }
        }
        stage('Build') {
            steps {
                sh '''
                    if [ -d ".m2" ]; then
                        echo "Using cached dependencies"
                    else
                        echo "No cache found, initializing directory structure"
                        mkdir -p .m2
                    fi
                    
                    # Always compile code, pointing Maven directly to our workspace cache
                    mvn clean compile -Dmaven.repo.local=.m2/repository
                '''
            }
        }
    }
}


