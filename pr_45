Ansible — Install Nginx, Start + Enable Service

---
- name: Configure Nginx server
  hosts: all
  become: yes

  tasks:
    - name: Install Nginx
      package:
        name: nginx
        state: present

    - name: Start and enable Nginx
      service:
        name: nginx
        state: started
        enabled: yes


