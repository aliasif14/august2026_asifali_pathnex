Kubernetes — Multi-Container Pod
apiVersion: v1
kind: Pod

metadata:
  name: pathnex-sidecar

spec:
  containers:
    - name: app
      image: nginx

    - name: log-writer
      image: busybox
      command:
        - sh
        - -c
        - while true; do echo log entry; sleep 5; done


Shell Script — Count Files#!/bin/bash

DIR="/var/log"

COUNT=$(ls $DIR | wc -l)

echo "Total files in $DIR: $COUNT"

GitLab CI — Cache Dependencies
stages:
  - build

variables:
  INSTITUTE_NAME: "Pathnex"
  TEAM: "DevOps"
  ENV: "staging"

  MAVEN_OPTS: "-Dmaven.repo.local=.m2/repository"

cache:
  key: "${ENV}-maven-cache"

  paths:
    - .m2/repository

build:
  stage: build

  image: maven:3.8.1-jdk-17

  script:
    - mvn clean compile
    - echo "Cached dependencies for $INSTITUTE_NAME in $ENV by $TEAM"

