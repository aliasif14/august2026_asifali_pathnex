Shell — Menu: IP / Disk / Memory
#!/bin/bash

echo "1. IP"
echo "2. Disk"
echo "3. Memory"

read -p "Choose an option: " choice

case $choice in
    1)
        echo "IP Address:"
        hostname -I
        ;;
    2)
        echo "Disk Usage:"
        df -h
        ;;
    3)
        echo "Memory Usage:"
        free -h
        ;;
    *)
        echo "Invalid option"
        ;;
esac


Jenkins Declarative Pipeline
pipeline {
    agent any

    environment {
        INSTITUTE_NAME = "Pathnex"
        TEAM = "DevOps"
        ENV = "prod"
        PROJECT = "Pathnex-Training"
    }

    stages {

        stage('Infrastructure') {
            steps {
                echo "Creating infrastructure for $PROJECT"

                sh '''
                    cd terraform
                    terraform init
                    terraform apply -auto-approve
                '''
            }
        }

        stage('App Deployment') {
            steps {
                echo "Configuring application environment"

                sh '''
                    ansible-playbook \
                    -i ansible/inventory \
                    ansible/user.yml
                '''

                sh '''
                    kubectl apply -f kubernetes/deployment.yaml
                    kubectl apply -f kubernetes/service.yaml
                '''
            }
        }

        stage('Monitoring Checks') {
            steps {
                sh '''
                    chmod +x scripts/system-menu.sh
                    echo "1" | ./scripts/system-menu.sh
                    echo "2" | ./scripts/system-menu.sh
                    echo "3" | ./scripts/system-menu.sh
                '''
            }
        }
    }
