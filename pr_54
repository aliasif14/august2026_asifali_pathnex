Ansible — Create User + SSH Key + Bash Shell
- name: Configure Pathnex admin user
  hosts: all
  become: yes

  tasks:
    - name: Create pathnex-admin user
      user:
        name: pathnex-admin
        shell: /bin/bash
        state: present
        create_home: yes

    - name: Add SSH public key
      authorized_key:
        user: pathnex-admin
        key: "{{ lookup('file', '~/.ssh/id_rsa.pub') }}"
        state: present


