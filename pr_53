Terraform
provider "aws" {
  region = "us-east-1"
}

data "aws_ami" "amazon_linux" {
  most_recent = true

  owners = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }
}

resource "aws_key_pair" "pathnex_key" {
  key_name   = "pathnex-key"
  public_key = file("~/.ssh/id_rsa.pub")
}

resource "aws_security_group" "pathnex_sg" {
  name        = "pathnex-sg"
  description = "Security group for Pathnex server"

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "pathnex_ec2" {
  ami                    = data.aws_ami.amazon_linux.id
  instance_type          = "c5.xlarge"
  key_name               = aws_key_pair.pathnex_key.key_name
  vpc_security_group_ids = [aws_security_group.pathnex_sg.id]

  tags = {
    Name    = "Pathnex-EC2"
    Project = "Pathnex-Training"
    Team    = "DevOps"
    Env     = "prod"
  }
}

resource "aws_ebs_volume" "pathnex_ebs" {
  availability_zone = aws_instance.pathnex_ec2.availability_zone
  size              = 20
  type              = "gp3"

  tags = {
    Name = "Pathnex-EBS"
  }
}

resource "aws_volume_attachment" "pathnex_attachment" {
  device_name = "/dev/sdh"
  volume_id   = aws_ebs_volume.pathnex_ebs.id
  instance_id = aws_instance.pathnex_ec2.id
}



variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

output "instance_public_ip" {
  description = "Public IP of Pathnex EC2"

  value = aws_instance.pathnex_ec2.public_ip
}

