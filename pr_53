Jenkins Declarative Pipeline
pipeline {
    agent any

    environment {
        INSTITUTE_NAME = "Pathnex"
        TEAM = "DevOps"
        ENV = "prod"
        PROJECT = "Pathnex-Training"
    }

    stages {

        stage('Infrastructure') {
            steps {
                script {
                    echo "Creating infrastructure for $PROJECT"

                    sh '''
                        cd terraform
                        terraform init
                        terraform apply -auto-approve
                    '''
                }
            }
        }

        stage('App Deployment') {
            steps {
                script {
                    echo "Deploying application for $INSTITUTE_NAME"

                    sh '''
                        ansible-playbook -i ansible/inventory \
                        ansible/nginx.yml
                    '''

                    sh '''
                        kubectl apply -f kubernetes/pvc.yaml
                        kubectl apply -f kubernetes/deployment.yaml
                        kubectl apply -f kubernetes/service.yaml
                    '''
                }
            }
        }

        stage('Monitoring Checks') {
            steps {
                script {
                    echo "Running monitoring checks"

                    sh '''
                        chmod +x scripts/system-check.sh
                        ./scripts/system-check.sh
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pathnex deployment completed successfully"
        }

        failure {
            echo "Pathnex deployment failed"
        }
    }
}



