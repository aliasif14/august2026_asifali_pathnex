Ansible:Install nginx
---
- hosts: all
  tasks:
    - apt: name=nginx state=present


Terraform: EC2 (asifali_august)
provider "aws" { region = "ap-south-1" }
resource "aws_instance" "asifali_august" {
  ami           = "ami-0c7217cdde317cfec"
  instance_type = "t3.micro"
}

Kuberenetes:Deployment 2 replicas
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx
spec:
  replicas: 2
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
      - name: nginx
        image: nginx


